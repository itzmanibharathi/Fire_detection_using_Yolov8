# ===========================================
# FireWatch Backend — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- MongoDB ---
MONGO_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/firewatch
DB_NAME=firewatch
COLLECTION_NAME=detections

# --- Server ---
PORT=5000

# --- JWT Authentication ---
JWT_SECRET=replace_with_a_random_secret_string

# --- OpenRouter AI (Optional - Enables AI Insights) ---
# Obtain your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key

# Use "openrouter/free" for automatic zero-cost model routing,
# or specify an explicit free model ID (e.g. meta-llama/llama-3.2-3b-instruct:free)
OPENROUTER_MODEL=openrouter/free
APP_URL=https://fireguard-pws7.onrender.com
