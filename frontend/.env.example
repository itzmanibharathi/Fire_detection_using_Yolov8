# ===========================================
# FireWatch Frontend — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Backend API URL ---
# In production, set this to your deployed backend URL.
# In local development this can be omitted (defaults to http://localhost:5000).
VITE_BACKEND_URL=https://your-backend.onrender.com
