# ==============================================================================
# FireWatch AI — Complete System Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env in your respective directories or configure in Render:
#   backend/.env
#   frontend/.env
#   AI_model/.env
#
# NOTE: Never commit secret-bearing credentials or tokens to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Service Configuration (backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/firewatch?retryWrites=true&w=majority
DB_NAME=firewatch
COLLECTION_NAME=detections
JWT_SECRET=replace_with_a_secure_random_64_char_string

# OpenRouter Free LLM Integration (for AI Insights & Safety Assistant)
# Obtain an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
# Use "openrouter/free" for automatic routing to active zero-cost models
# (e.g. Llama 3.2, Mistral 7B, Gemma) or specify an explicit model ID
OPENROUTER_MODEL=openrouter/free
APP_URL=https://fireguard-pws7.onrender.com

# ------------------------------------------------------------------------------
# 2. Frontend Dashboard Configuration (frontend/.env)
# ------------------------------------------------------------------------------
# Local development: defaults to http://localhost:5000 automatically
# Production Render static site:
VITE_BACKEND_URL=https://fire-detection-using-yolov8.onrender.com

# ------------------------------------------------------------------------------
# 3. AI Model & Edge Detection Sensor (AI_model/.env)
# ------------------------------------------------------------------------------
# Cloudinary image storage for fire/smoke incident snapshots
CLOUD_NAME=replace_with_your_cloudinary_cloud_name
CLOUD_API_KEY=replace_with_your_cloudinary_api_key
CLOUD_API_SECRET=replace_with_your_cloudinary_api_secret

# Telegram Bot Alert Notifications
# Official bot creation guide: https://core.telegram.org/bots/api via @BotFather
TELEGRAM_TOKEN=replace_with_your_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_your_telegram_chat_id

# Station Geolocation (lat/lng coordinates for Leaflet alert map & Telegram)
LOCATION_NAME=Forest Monitoring Sector Alpha
LATITUDE=11.6500
LONGITUDE=77.1000

# Hardware User Access Code (links hardware telemetry directly to your dashboard)
# Available on the web portal at Settings -> Hardware Integration
USER_ACCESS_CODE=replace_with_your_unique_access_code

# Edge Model Detection Parameters
MODEL_PATH=best.pt
CONFIDENCE_THRESHOLD=0.70
ALERT_CLASSES=fire,smoke
SAVE_FOLDER=alerts
ALERT_COOLDOWN=10
ALERT_SOUND_PATH=alert.mp3
VIDEO_PATH=a.mp4
