# ===========================================
# FireWatch AI Model — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- MongoDB ---
MONGO_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/firewatch
DB_NAME=firewatch
COLLECTION_NAME=detections

# --- Cloudinary (Image Hosting for Detection Snapshots) ---
CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUD_API_KEY=replace_with_cloudinary_api_key
CLOUD_API_SECRET=replace_with_cloudinary_api_secret

# --- Telegram Bot Alerts ---
# Create a bot via https://t.me/BotFather to get the token.
TELEGRAM_TOKEN=replace_with_your_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_your_telegram_chat_id

# --- Detection Location ---
LOCATION_NAME=Your Monitoring Site Name
LATITUDE=11.5
LONGITUDE=77.2

# --- User Access Code ---
# Obtained from the FireWatch Dashboard (Settings > Hardware Integration)
USER_ACCESS_CODE=replace_with_your_unique_access_code

# --- Edge Detection Tuning (Optional) ---
MODEL_PATH=best.pt
CONFIDENCE_THRESHOLD=0.7
ALERT_CLASSES=fire,smoke
SAVE_FOLDER=alerts
ALERT_COOLDOWN=10
ALERT_SOUND_PATH=alert.mp3
VIDEO_PATH=a.mp4
